# ====== FinQuery RAG 环境变量配置 ======
# 部署在云服务器 (2核2G) 上，通过 FRP 穿透访问学校 GPU 服务器

# ====== 在线对话：指向 FRP 映射回来的本地 8500 端口 (学校算力) ======
# FRP 将云服务器的 127.0.0.1:8500 映射到学校 GPU 服务器的 8998 端口
LLM_API_BASE_URL=http://127.0.0.1:8500/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL_NAME=nanochat

# ====== 离线数据清洗：NVIDIA 开放平台配置 ======
# 用于 PDF 表格语义增强 (process_tables.py)
# 获取 API Key: https://build.nvidia.com/meta/llama-3_1-8b-instruct
NVIDIA_API_KEY=nvapi-your-real-nvidia-key-here
NVIDIA_MODEL_NAME=meta/llama-3.1-8b-instruct

# ====== 数据库配置 ======
# PostgreSQL (生产环境) 或 SQLite (开发环境)
DATABASE_URL=sqlite:///./temp.db

# ====== 安全配置 ======
# JWT 密钥 (生产环境请更换为随机强密钥)
SECRET_KEY=9594873a5e0a8ccde1adc3af1ba93f5f2bcc5632b77b750452713d216791c013

# ====== 跨域配置 ======
# 允许的前端来源，多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ====== 向量数据库路径 ======
CHROMA_PATH=./chroma_db

# ====== PDF 解析后端 ======
# native（默认）：PyMuPDF + Camelot + 原生表格回退，零额外模型常驻。
# mineru：显式使用已部署的 MinerU CLI/API，适合扫描件、复杂布局或跨页表格。
# auto：默认仍使用 native；仅在同时开启 MINERU_AUTO_ENABLED 且配置 API 时，
#       对低文本（通常为扫描件）文件路由至 MinerU。
PARSER_BACKEND=native

# 可选 MinerU 服务配置；默认留空，不会下载模型或占用 GPU。
# MINERU_COMMAND=mineru
# MINERU_API_URL=http://127.0.0.1:8001
# MINERU_BACKEND=pipeline
# MINERU_TIMEOUT_SECONDS=600
# MINERU_AUTO_ENABLED=false
# MINERU_AUTO_SAMPLE_PAGES=3
# MINERU_AUTO_MIN_TEXT_CHARS=80

# ====== Financial runtime selection (TV2-08) ======
# v2 is the official default; v1 is an explicit rollback and shadow is diagnostic.
FINANCIAL_RUNTIME_MODE=v2
# V2 shadow branch timeout in milliseconds.
V2_SHADOW_TIMEOUT_MS=5000

# Active Conversation Context is the default; off/shadow remain rollback and diagnostic modes.
MULTITURN_CONTEXT_MODE=on
# Canonical V2 production builder. It fails fast until the R4 index, fact
# registry, provider credentials, and specialist checkpoint below are provisioned.
TRUSTED_V2_RUNTIME_BUILDER=src.runtime.trusted_v2_production:build_trusted_v2_runtime_for_request

# Read-only R4 candidate index and structured financial-fact registry.
# The index must contain candidate-metadata.sqlite plus all four candidate lanes:
# candidate_raw_bm25, candidate_structured_bm25, candidate_raw_dense,
# candidate_structured_dense. The fact registry may be JSON/JSONL (optionally
# gzip-compressed) and must carry evidence_id, citation_id, physical source
# identity, and provenance_complete=true for every materialized candidate.
# TRUSTED_V2_R4_INDEX_DIR=/srv/finquery/r4-candidate-index
# TRUSTED_V2_FACT_STORE_PATH=/srv/finquery/financial-facts.jsonl.gz

# V2 Supervisor and Semantic Binder providers. The Binder falls back to the
# Supervisor endpoint/model when its dedicated values are omitted.
# V2_SUPERVISOR_PROVIDER=bailian
# V2_SUPERVISOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# V2_SUPERVISOR_API_KEY=replace-with-deployment-secret
# V2_SUPERVISOR_MODEL=qwen-plus
# V2_BINDER_PROVIDER=bailian
# V2_BINDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# V2_BINDER_API_KEY=replace-with-deployment-secret
# V2_BINDER_MODEL=qwen-plus

# Verified local Financial Specialist checkpoint. The builder validates the
# checkpoint using the existing Specialist loader before serving V2 traffic.
# TRUSTED_V2_SPECIALIST_CHECKPOINT=/srv/finquery/checkpoints/model_000156.pt
# TRUSTED_V2_SPECIALIST_DEVICE=cuda:0

# Bounded V2 execution controls (defaults are intentionally conservative).
# V2_MAX_REPLANS=2
# V2_MAX_TOOL_CALLS=5
# V2_MAX_SAME_TOOL_RETRIES=1
# V2_MAX_IDENTICAL_QUERY_RETRIES=0
